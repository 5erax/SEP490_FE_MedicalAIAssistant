# Backend API origin for the local Vite dev proxy
VITE_API_BASE_URL=http://52.77.210.243

# Backend API base URL for the Vercel /api serverless proxy
API_BASE_URL=http://52.77.210.243

# Google OAuth Client ID - Must be configured for each domain
# For localhost: Create credential in Google Cloud Console for http://localhost:3000
# For Vercel: Create credential for https://sep-490-fe-medical-ai-assistant.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_AUTHORIZED_ORIGINS=http://localhost:3000,https://your-preview-or-production-domain.example.com

# Cloudinary unsigned upload config for images and user-selected lab documents
# Create an unsigned upload preset in Cloudinary and do not expose API secret in frontend.
VITE_CLOUDINARY_CLOUD_NAME=dnfcv21cy
VITE_CLOUDINARY_UPLOAD_PRESET=medimate_unsigned
VITE_CLOUDINARY_UPLOAD_FOLDER=medical-facilities
