# Backend API base URL for local Vite dev proxy
VITE_API_BASE_URL=http://localhost:8080

# Backend API base URL for the Vercel /api serverless proxy
API_BASE_URL=https://your-backend.example.com

# Google OAuth Client ID - Must be configured for each domain
# For localhost: Create credential in Google Cloud Console for http://localhost:3000
# For Vercel: Create credential for https://sep-490-fe-medical-ai-assistant.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Cloudinary unsigned upload config for facility images
# Create an unsigned upload preset in Cloudinary and do not expose API secret in frontend.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_UPLOAD_FOLDER=medical-facilities
