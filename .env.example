# Local backend example:
# VITE_API_BASE_URL=https://localhost:7045

# On Vercel, keep production requests on same-origin /api proxy in vercel.json.
VITE_API_BASE_URL=

# Google OAuth Client ID - Must be configured for each domain
# For localhost: Create credential in Google Cloud Console for http://localhost:3000
# For Vercel: Create credential for https://sep-490-fe-medical-ai-assistant.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
