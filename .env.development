# Development environment variables for localhost
# Domain: http://localhost:3000

# API Base URL for local development
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth Client ID for localhost
# This must be registered in Google Cloud Console with http://localhost:3000
# and https://localhost:3000 as authorized redirect URIs
VITE_GOOGLE_CLIENT_ID=your_localhost_google_client_id_here
