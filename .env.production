# Production environment variables for Vercel deployment
# Domain: https://sep-490-fe-medical-ai-assistant.vercel.app

# API Base URL for production deployment
# Set API_BASE_URL in Vercel so /api/proxy forwards requests to the backend.
VITE_API_BASE_URL=/api
API_BASE_URL=http://52.77.210.243

# Google OAuth Client ID for production domain
# This must be registered in Google Cloud Console with the Vercel domain
VITE_GOOGLE_CLIENT_ID=976426394148-eub0i02sbrseoob7r4lbe8ubr3bqv3n2.apps.googleusercontent.com
VITE_GOOGLE_AUTHORIZED_ORIGINS=https://sep-490-fe-medical-ai-assistant.vercel.app,https://sep-490-fe-medical-ai-assista-git-9aca09-dhas-projects-901181f4.vercel.app

# Cloudinary unsigned upload config for medical facility and doctor images
VITE_CLOUDINARY_CLOUD_NAME=dnfcv21cy
