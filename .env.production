# Production environment variables for Vercel deployment
# Domain: https://sep-490-fe-medical-ai-assistant.vercel.app

# Production uses same-origin /api/* requests through Vercel rewrites.
# Set BACKEND_API_ORIGIN in Vercel Project Settings instead of exposing it as VITE_*.
VITE_API_BASE_URL=

# Google OAuth Client ID for production domain
# This must be registered in Google Cloud Console with the Vercel domain
VITE_GOOGLE_CLIENT_ID=
